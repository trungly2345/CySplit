<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ThemeOverlay_App_Light" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorSecondaryContainer">@color/gold_light</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/text_primary_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>

        <!-- Optional -->
        <item name="colorTertiary">@color/gold</item>
        <item name="colorOnTertiary">@android:color/black</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
    </style>

    <style name="ThemeOverlay_App_Dark" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@android:color/white</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/gold_dark</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorSecondaryContainer">@color/gold</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/gold_dark</item>
        <item name="colorOnTertiary">@android:color/white</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>

</resources>