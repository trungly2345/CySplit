<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/billTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bill Title"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/billAmountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/billDescriptionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bill Description"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/billStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bill Status"
        android:layout_marginTop="4dp"/>

    <Button
        android:id="@+id/payButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pay"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/backToGroupButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Group"
        android:layout_marginTop="8dp"/>

    <FrameLayout
        android:id="@+id/billChatContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"/>

</LinearLayout>