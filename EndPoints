***USERGROUP (Group Membership) ENDPOINTS

# Get all groups for a user
GET http://localhost:8080/users/{userId}/groups

# Get active groups for a user
GET http://localhost:8080/users/{userId}/groups/active

# Get all members of a group
GET http://localhost:8080/groups/{groupId}/members

# Get active members of a group
GET http://localhost:8080/groups/{groupId}/members/active

# Get admins of a group
GET http://localhost:8080/groups/{groupId}/admins

# Get member count for a group
GET http://localhost:8080/groups/{groupId}/members/count

# Add user to group
POST http://localhost:8080/groups/{groupId}/members
Content-Type: application/json
{
  "userId": 1,
  "role": "MEMBER"
}

# Accept invitation (adds user to group, sends notification)
POST http://localhost:8080/invitations/{invitationId}/accept

# Update user role in group (sends notification)
PUT http://localhost:8080/groups/{groupId}/members/{userId}/role
Content-Type: application/json
{
  "role": "ADMIN"
}

# Update user contribution score
PUT http://localhost:8080/groups/{groupId}/members/{userId}/contribution
Content-Type: application/json
{
  "contributionScore": 100.5
}

# Remove user from group (sends notification)
DELETE http://localhost:8080/groups/{groupId}/members/{userId}

# Leave group (sends notification)
PUT http://localhost:8080/groups/{groupId}/members/{userId}/leave


